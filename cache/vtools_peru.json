": null, "created-at": "2026-09-08T21:47:29.000Z", "updated-at": "2026-09-14T20:07:40.000Z", "pricing": null, "speakers": null, "media": null, "enhanced-report": null}, {"id": 575172, "title": "Women in Biomedical Engineering: Networking & Panel", "description": "<p><strong>Women in Biomedical Engineering:</strong> Liderazgo, Innovaci&oacute;n y Networking ser&aacute; un encuentro presencial en UPC Monterrico donde conoceremos nuevas tecnolog&iacute;as, proyectos innovadores y tendencias que est&aacute;n transformando la Ingenier&iacute;a Biom&eacute;dica. Contaremos con mujeres profesionales e investigadoras que compartir&aacute;n sus experiencias, avances y oportunidades en &aacute;reas como dispositivos m&eacute;dicos, inteligencia artificial, im&aacute;genes m&eacute;dicas, bioingenier&iacute;a e innovaci&oacute;n en salud. El evento incluir&aacute; un panel, preguntas del p&uacute;blico y un espacio de networking para conectar con las ponentes y otras estudiantes interesadas en el futuro de la tecnolog&iacute;a m&eacute;dica.</p>", "start-time": "2026-11-16T18:00:00.000Z", "end-time": "2026-11-18T18:00:00.000Z", "time-zone": {"name": "America/Lima", "utc-offset": -5}, "primary-host": {"spoid": "SBA60381", "name": "Universidad Peruana de Ciencias Aplicadas, WIE", "class_code": "SUBO", "class_description": "Organizational SPO", "type_code": "AFFN", "type_description": "Affinity", "section_spoids": "R90721", "region_spoids": "R9", "society_spoids": "WIE050"}, "cohosts": [], "header": "<p><img src=\"https://events.vtools.ieee.org/vtools_ui/media/display/4b2a0538-48d5-47d1-ab83-c7adc384af17\" alt=\"\" width=\"336\" height=\"420\"></p>", "footer": "", "keywords": " #biomedical-engineering #networking #ieeewieupc #mujeresenstem #upc #WIE #Mujereseningenieríabiomédica #MedTech #InnovationInHealth\r\n#FutureOfHealthcare", "tags": ["#biomedical-engineering", "#networking", "#ieeewieupc", "#mujeresenstem", "#upc", "#WIE", "#Mujereseningenieríabiomédica", "#MedTech", "#InnovationInHealth", "#FutureOfHealthcare"], "agenda": null, "contact-email": "ieee.upc.wie@gmail.com", "contact-display": "", "cosponsor-name": "", "location-type": "physical", "virtual-info": null, "address1": "", "address2": "", "city": "Lima", "postal-code": "", "building": "", "room-number": "", "map-url": "", "latitude": null, "longitude": null, "image": null, "image-mime-type": null, "registration-start-time": "2026-08-20T05:00:00.000Z", "registration-end-time": "2026-11-11T05:00:00.000Z", "registration-url": "https://events.vtools.ieee.org/event/register/575172", "survey-url": "", "cost": false, "max-registrations": 100, "cancelled": false, "uid": "CB636ABF-66FC-4A9D-950A-15CB513A25F6", "publish": true, "virtual": false, "link": "https://events.vtools.ieee.org/m/575172", "ieee-attending": null, "guests-attending": null, "created-at": "2026-09-01T05:16:34.000Z", "updated-at": "2026-09-01T06:17:25.000Z", "pricing": null, "speakers": null, "media": null, "enhanced-report": null}, {"id": 575012, "title": "14th Anniversary IEEE WIE UNAC: Empowering Women in STEM", "description": "<p data-path-to-node=\"6\">El IEEE WIE (Women in Engineering) Affinity Group de la Universidad Nacional del Callao los invita a participar en la celebraci&oacute;n de nuestro aniversario. Este evento tiene como objetivo destacar la trayectoria, los logros y el impacto de nuestra comunidad en la promoci&oacute;n del talento femenino en &aacute;reas STEM (Ciencia, Tecnolog&iacute;a, Ingenier&iacute;a y Matem&aacute;ticas).</p>\r\n<p data-path-to-node=\"7\">Durante esta jornada, contaremos con la participaci&oacute;n de destacadas ponentes, talleres interactivos y espacios de networking orientados al desarrollo profesional, el liderazgo t&eacute;cnico y la innovaci&oacute;n.</p>", "start-time": "2026-10-12T23:00:00.000Z", "end-time": "2026-10-18T01:00:00.000Z", "time-zone": {"name": "America/Lima", "utc-offset": -5}, "primary-host": {"spoid": "SBA21571", "name": "Universidad Nacional del Calla